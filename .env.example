# =============================================================================
# MAHIKS-TR — top-level environment template
# -----------------------------------------------------------------------------
# This file documents the env vars you need to set in **production** across
# Hugging Face Spaces and Vercel. It is NOT loaded by the running app.
#
# For local docker-compose development see backend/.env.example instead.
#
# Generate the two secrets ONCE and store them in a password manager:
#   python -c "import secrets; print('JWT_SECRET_KEY=' + secrets.token_urlsafe(64))"
#   python -c "from cryptography.fernet import Fernet; print('API_KEY_ENCRYPTION_KEY=' + Fernet.generate_key().decode())"
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# Hugging Face Space — Settings → Variables and secrets  (SECRETS)
# ─────────────────────────────────────────────────────────────────────────────

# JWT signing key for the FastAPI auth layer.  Rotating this logs everyone
# out, so treat it as long-lived.
JWT_SECRET_KEY=

# Fernet key used to encrypt user-supplied LLM API keys at rest.
# ⚠ NEVER LOSE THIS KEY — all encrypted user keys become unrecoverable.
API_KEY_ENCRYPTION_KEY=

# Neon Postgres pooled connection string.  Must include sslmode=require.
DATABASE_URL=postgresql://user:pass@ep-xxxxx.eu-central-1.aws.neon.tech/dbname?sslmode=require

# Comma-separated list of allowed browser origins (Vercel URL + localhost dev).
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173


# ─────────────────────────────────────────────────────────────────────────────
# Hugging Face Space — Settings → Variables and secrets  (PUBLIC VARIABLES)
# ─────────────────────────────────────────────────────────────────────────────

# Embedding model used for chunk + KG vectors. Leave as default unless you
# know what you're doing — the Dockerfile pre-warms this exact model.
SUT_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# (Do NOT override HF_HOME on the Space — the Dockerfile bakes it to
#  /data/hf_cache, which lives on the Space's persistent volume.)


# ─────────────────────────────────────────────────────────────────────────────
# Vercel — Project Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the deployed HF Space backend. Add to Production, Preview, and
# Development scopes. The Vite build inlines this at build time, so changing
# it requires a redeploy.
# VITE_API_BASE_URL=https://your-user-mahiks-tr.hf.space
