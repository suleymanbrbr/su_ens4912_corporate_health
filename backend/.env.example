# === REQUIRED in production ===
JWT_SECRET_KEY=
API_KEY_ENCRYPTION_KEY=
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
CORS_ORIGINS=https://mahiks.vercel.app,http://localhost:5173

